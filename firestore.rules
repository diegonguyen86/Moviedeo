rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== HÀM DÙNG CHUNG =====================
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "qD9qHFwiucgQOj6bXHoCIuHuoWv1";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Đã được Admin duyệt (đọc từ hồ sơ user; Admin luôn được coi là đã duyệt)
    function isApproved() {
      return isAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isApproved', false) == true
      );
    }

    // Thống kê giờ xem (tính hạng) & số phim đã xem chỉ được CỘNG THÊM từng chút như khi xem thật:
    // mỗi lần ghi tối đa +3600 giây và +1 phim, không được giảm. Trước đây người dùng tự sửa được
    // totalWatchSeconds thành số bất kỳ (vd 9.999.999) để lên hạng cao nhất.
    function watchStatsOk() {
      let secBefore = resource.data.get('totalWatchSeconds', 0);
      let secAfter = request.resource.data.get('totalWatchSeconds', 0);
      let cntBefore = resource.data.get('watchedCount', 0);
      let cntAfter = request.resource.data.get('watchedCount', 0);
      return secAfter - secBefore >= 0 && secAfter - secBefore <= 3600
        && cntAfter - cntBefore >= 0 && cntAfter - cntBefore <= 1;
    }

    // ===================== 1. HỒ SƠ USER =====================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Tạo hồ sơ lần đầu: KHÔNG được tự đặt isApproved = true
      allow create: if isOwner(userId)
        && request.resource.data.get('isApproved', false) == false
        && !('adminNotifiedAt' in request.resource.data)
        && request.resource.data.get('totalWatchSeconds', 0) <= 3600
        && request.resource.data.get('watchedCount', 0) <= 1;

      // Cập nhật (thống kê giờ xem, số phim...): KHÔNG được đụng vào các trường do Admin/Server quản lý
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isApproved', 'adminNotifiedAt', 'uid', 'createdAt'])
        && watchStatsOk()
      );

      allow delete: if isAdmin();

      // Lịch sử xem phim & các dữ liệu con của user: chỉ chính chủ
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ===================== 2. DANH SÁCH YÊU THÍCH =====================
    // Mỗi document có userId; chỉ chủ nhân được đọc / ghi / xoá
    match /watchlists/{watchlistId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isApproved()
        && request.resource.data.userId == request.auth.uid
        && watchlistId == request.auth.uid + '_' + request.resource.data.slug;
    }

    // ===================== 3. CÀI ĐẶT ADMIN (TOP TRENDING) =====================
    match /admin_settings/{document=**} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ===================== 4. BÌNH LUẬN TỪNG PHIM =====================
    match /comments/{movieId}/list/{commentId} {
      allow read: if isApproved();
      // Chỉ được đăng dưới tên chính mình, nội dung 1-1000 ký tự
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      // Không ai sửa bình luận của người khác; chỉ chủ bình luận hoặc Admin được xoá
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ===================== 5. BẢNG TIN LIVE TOÀN TRANG =====================
    match /global_comments/{commentId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ===================== 6. PHIÊN ĐĂNG NHẬP TV =====================
    // TV chưa đăng nhập nên phải cho phép không cần auth, NHƯNG:
    // - Chỉ được đọc đúng 1 phiên khi biết mã (get), KHÔNG được liệt kê toàn bộ (list)
    //   -> trước đây ai cũng list được và lấy customToken của người khác để đăng nhập thay họ.
    // - Chỉ được tạo phiên mới ở trạng thái "pending", không được tự chèn token/uid.
    // - Việc duyệt (ghi customToken) do server /api/tv-auth làm bằng Admin SDK (không qua rules).
    match /tv_auth_sessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.get('status', '') == 'pending'
        && !('customToken' in request.resource.data)
        && !('uid' in request.resource.data)
        // Thời điểm tạo phải là giờ server (TV dùng serverTimestamp) -> không tự đặt giờ để né hạn 30 phút
        && request.resource.data.get('createdAt', null) == request.time;
      allow update: if false;
      allow delete: if true; // TV tự dọn phiên sau khi đăng nhập xong
    }
  }
}
